{
  "name": "opentagcloud-monorepo",
  "private": true,
  "description": "openTagCloud monorepo \u2014 framework-agnostic core plus Svelte, React, Vue, Angular, SolidJS, and Next.js adapters.",
  "license": "MIT",
  "author": "Henry Koren",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @opentagcloud/core && npm run build -w opentagcloud -w @opentagcloud/react -w @opentagcloud/vue -w @opentagcloud/solid -w @opentagcloud/next && npm run build -w @opentagcloud/angular",
    "dev": "npm run dev -w opentagcloud",
    "check": "npm run check -w opentagcloud",
    "test": "npm run test -w @opentagcloud/core -w opentagcloud -w @opentagcloud/react -w @opentagcloud/vue -w @opentagcloud/solid -w @opentagcloud/angular",
    "test:e2e": "playwright test",
    "pages:build": "npm run build -w @opentagcloud/core && node scripts/build-pages.mjs",
    "release": "node scripts/publish.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "esbuild": "^0.28.0",
    "jsdom": "^31.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^4.1.1"
  },
  "overrides": {
    "@angular/common": "^20.3.35",
    "@angular/compiler": "^20.3.35",
    "@angular/compiler-cli": "^20.3.35",
    "@angular/core": "^20.3.35",
    "@angular/platform-browser": "^20.3.35",
    "@angular/platform-browser-dynamic": "^20.3.35",
    "@jest/reporters": {
      "glob": "^14.0.2"
    },
    "@vue/test-utils": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    },
    "jest-config": {
      "glob": "^14.0.2"
    },
    "jest-runtime": {
      "glob": "^14.0.2"
    },
    "test-exclude": {
      "glob": "^14.0.2",
      "minimatch": "^11.0.1"
    }
  }
}
